---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Pagination from '../components/Pagination.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { siteConfig } from '../config/site';
import { getPublishedPosts, paginate, postsPerPage } from '../lib/posts';

const posts = await getPublishedPosts();
const { items, currentPage, totalPages } = paginate(posts, 1, postsPerPage());
---

<BaseLayout>
	<section class="pt-14 sm:pt-20">
		<h1 class="text-3xl font-medium tracking-tight text-gray-900 sm:text-4xl">
			你好，我是 {siteConfig.author}
		</h1>
		<p class="mt-4 max-w-xl text-sm leading-7 text-slate-500 sm:text-[15px]">
			{siteConfig.description}
		</p>
		<SocialLinks class="mt-6" />
	</section>

	<div class="my-12 h-px bg-gray-200 sm:my-16"></div>

	<section>
		<h2 class="mb-3 text-sm font-medium text-gray-900">最新文章</h2>
		<PostList posts={items} />
	</section>

	<Pagination currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
