---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Pagination from '../../components/Pagination.astro';
import { getPublishedPosts, paginate, postsPerPage } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const totalPages = Math.max(1, Math.ceil(posts.length / postsPerPage()));
	return Array.from({ length: totalPages - 1 }, (_, index) => ({
		params: { page: String(index + 2) },
		props: { posts, page: index + 2 },
	}));
}

const { posts, page } = Astro.props;
const { items, currentPage, totalPages } = paginate(posts, page, postsPerPage());
---

<BaseLayout title={`第 ${currentPage} 页`} description="浏览更早的文章。">
	<div class="pt-14 sm:pt-20">
		<h1 class="text-3xl font-medium tracking-tight text-gray-900 sm:text-4xl">最新文章</h1>
		<p class="mt-3 text-sm leading-7 text-slate-500">第 {currentPage} / {totalPages} 页</p>
	</div>

	<div class="mt-10">
		<PostList posts={items} />
	</div>

	<Pagination currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
