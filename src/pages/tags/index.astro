---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { getAllTags, getPublishedPosts } from '../../lib/posts';

const tags = getAllTags(await getPublishedPosts());
---

<BaseLayout title="标签" description="按标签浏览全部文章。">
	<div class="pt-14 sm:pt-20">
		<h1 class="text-3xl font-medium tracking-tight text-gray-900 sm:text-4xl">标签</h1>
		<p class="mt-3 text-sm leading-7 text-slate-500">按标签浏览全部文章。</p>
	</div>

	<div class="mt-12">
		{
			tags.length > 0 ? (
				<TagList tags={tags} />
			) : (
				<p class="text-sm text-slate-500">暂无标签。</p>
			)
		}
	</div>

	<div class="mt-10 border-t border-gray-200 pt-8">
		<a href="/" class="text-xs text-slate-500 transition-colors hover:text-gray-900">
			← 返回首页
		</a>
	</div>
</BaseLayout>
