---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getAllTags, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const tags = getAllTags(posts);
	return tags.map(({ tag }) => ({
		params: { tag },
		props: {
			tag,
			posts: posts.filter((post) => post.data.tags.includes(tag)),
		},
	}));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`带有 #${tag} 标签的文章。`}>
	<div class="pt-14 sm:pt-20">
		<h1 class="text-3xl font-medium tracking-tight text-gray-900 sm:text-4xl">#{tag}</h1>
		<p class="mt-3 text-sm leading-7 text-slate-500">共 {posts.length} 篇文章</p>
	</div>

	<div class="mt-10">
		<PostList posts={posts} />
	</div>

	<div class="mt-10 border-t border-gray-200 pt-8">
		<a href="/tags/" class="text-xs text-slate-400 transition-colors hover:text-gray-900">
			← 全部标签
		</a>
	</div>
</BaseLayout>
