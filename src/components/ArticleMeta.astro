---
import { formatDate } from '../lib/posts';

interface Props {
	pubDate: Date;
	updatedDate?: Date;
	readingTime: number;
	tags: string[];
}

const { pubDate, updatedDate, readingTime, tags } = Astro.props;
---

<div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-slate-400">
	<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
	<span aria-hidden="true">·</span>
	<span>约 {readingTime} 分钟</span>
	{
		tags.map((tag) => (
			<>
				<span aria-hidden="true">·</span>
				<a href={`/tags/${tag}/`} class="transition-colors hover:text-gray-900">
					#{tag}
				</a>
			</>
		))
	}
	{updatedDate && <span class="text-slate-400">更新于 {formatDate(updatedDate)}</span>}
</div>
