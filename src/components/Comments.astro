---
import { siteConfig } from '../config/site';

const { embedUrl, siteId, targetId } = siteConfig.comments;
---

<section class="mt-14 overflow-hidden rounded-xl border border-gray-200 bg-white px-5 py-4" aria-label="评论">
	<div id={targetId}></div>
	<script is:inline src={embedUrl} data-site={siteId} data-target={targetId} defer></script>
</section>
