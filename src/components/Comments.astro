---
import { siteConfig } from '../config/site';

const { embedUrl, siteId, targetId } = siteConfig.comments;
---

<section class="mt-6 pt-6" aria-label="评论">
	<div id={targetId}></div>
	<script is:inline src={embedUrl} data-site={siteId} data-target={targetId} data-border defer></script>
</section>
