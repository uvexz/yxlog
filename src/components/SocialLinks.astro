---
import { socialIconPaths } from '../lib/icons';
import { siteConfig } from '../config/site';

interface Props {
	class?: string;
	size?: number;
}

const { class: className, size = 17 } = Astro.props;
---

<div class:list={['flex items-center gap-4 text-slate-500', className]}>
	{
		siteConfig.social.map((link) => (
			<a
				href={link.href}
				aria-label={link.label}
				{...(link.icon !== 'email' ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
				class="transition-colors hover:text-gray-900"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width={size}
					height={size}
					fill="currentColor"
					viewBox="0 0 256 256"
					aria-hidden="true"
					set:html={socialIconPaths[link.icon]}
				/>
			</a>
		))
	}
</div>
