---
interface Props {
	currentPage: number;
	totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

const href = (page: number) => (page === 1 ? '/' : `/page/${page}/`);
const pages = Array.from({ length: totalPages }, (_, index) => index + 1);
---

{
	totalPages > 1 && (
		<nav
			class="mt-10 flex items-center justify-center gap-4 text-xs text-slate-500"
			aria-label="分页"
		>
			{currentPage > 1 ? (
				<a
					href={href(currentPage - 1)}
					class="transition-colors hover:text-gray-900"
					aria-label="上一页"
				>
					‹
				</a>
			) : (
				<span class="cursor-default opacity-40" aria-hidden="true">
					‹
				</span>
			)}

			{pages.map((page) =>
				page === currentPage ? (
					<span class="rounded-full bg-slate-100 px-2.5 py-1 text-gray-700" aria-current="page">
						{page}
					</span>
				) : (
					<a
						href={href(page)}
						class="transition-colors hover:text-gray-900"
						aria-label={`第 ${page} 页`}
					>
						{page}
					</a>
				)
			)}

			{currentPage < totalPages ? (
				<a
					href={href(currentPage + 1)}
					class="transition-colors hover:text-gray-900"
					aria-label="下一页"
				>
					›
				</a>
			) : (
				<span class="cursor-default opacity-40" aria-hidden="true">
					›
				</span>
			)}
		</nav>
	)
}
