---
import Search from './Search.tsx';
import { siteConfig } from '../config/site';
import { getPublishedPosts, toSearchItems } from '../lib/posts';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string): boolean {
	const target = href.replace(/\/+$/, '') || '/';
	if (target === '/') return pathname === '/';
	return pathname === target || pathname.startsWith(`${target}/`);
}

const searchItems = toSearchItems(await getPublishedPosts());
---

<header class="relative mx-auto w-full max-w-3xl px-6 pt-7 sm:px-8">
	<div class="flex items-center justify-between">
		<a href="/" class="text-sm font-semibold tracking-tight text-gray-900">{siteConfig.name}</a>
		<nav class="flex items-center gap-5 text-xs text-slate-500 sm:gap-6" aria-label="主导航">
			{siteConfig.nav.map((item) => (
				<a
					href={item.href}
					aria-current={isActive(item.href) ? 'page' : undefined}
					class:list={[
						'relative py-1 transition-colors hover:text-gray-900',
						isActive(item.href) && 'text-gray-900',
					]}
				>
					{item.label}
					{isActive(item.href) && (
						<span class="absolute inset-x-0 -bottom-0.5 h-px bg-[#7b9bbd]" aria-hidden="true" />
					)}
				</a>
			))}
			<Search client:idle items={searchItems} />
		</nav>
	</div>
</header>
