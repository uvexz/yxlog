---
import SocialLinks from './SocialLinks.astro';
import { siteConfig } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-3xl px-6 pb-6 sm:px-8">
	<div
		class="flex flex-col gap-4 pt-6 text-[11px] text-slate-500 sm:flex-row sm:items-center sm:justify-between"
	>
		<span>© {year} {siteConfig.author}. 保留所有权利。</span>
		<SocialLinks />
	</div>
</footer>
